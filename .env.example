# انسخ هذا الملف إلى .env في جذر المشروع واملأ القيم. لا تشارك .env مع أحد.

# ---------- عام ----------
API_KEY=                      # اختياري. إن وضعته ضع نفس القيمة في frontend/.env كـ VITE_API_KEY
CORS_ORIGINS=http://localhost:5173

# ---------- مستقل / السحب ----------
MOSTAQL_BASE=https://mostaql.com
MY_PROPOSALS_PATH=/dashboard/bids   # عدّله حسب رابط صفحة "عروضي" عندك
MAX_LIST_PAGES=2
MAX_DETAIL_FETCH=15
DELAY_MIN=3
DELAY_MAX=7
HEADLESS=true

# ---------- Gemini ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash       # غيّره لأي نموذج متاح في حسابك (AI Studio)
NOTIFY_THRESHOLD=70
MAX_AI_PER_REFRESH=20
MAX_NOTIFY_PER_REFRESH=8

# ---------- تيليجرام ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- n8n ----------
# FastAPI على ويندوز يصل إلى n8n عبر localhost. اتركه فارغاً لإرسال مباشر دون n8n.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/mostaql-notify
N8N_SHARED_SECRET=change-me-to-a-long-random-string
