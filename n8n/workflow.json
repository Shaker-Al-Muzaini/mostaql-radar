{
  "name": "Mostaql Radar - Telegram Notify",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mostaql-notify",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Webhook من FastAPI",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "mostaql-notify"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.secret }}",
              "rightValue": "={{ $env.N8N_SHARED_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "التحقق من السر",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body.telegram) }}",
        "options": { "timeout": 20000 }
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "إرسال إلى تيليجرام",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, -80]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": { "responseCode": 200 }
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "رد: تم",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, -80]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'unauthorized' }) }}",
        "options": { "responseCode": 401 }
      },
      "id": "55555555-5555-4555-8555-555555555555",
      "name": "رد: غير مصرّح",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 120]
    }
  ],
  "connections": {
    "Webhook من FastAPI": { "main": [[{ "node": "التحقق من السر", "type": "main", "index": 0 }]] },
    "التحقق من السر": {
      "main": [
        [{ "node": "إرسال إلى تيليجرام", "type": "main", "index": 0 }],
        [{ "node": "رد: غير مصرّح", "type": "main", "index": 0 }]
      ]
    },
    "إرسال إلى تيليجرام": { "main": [[{ "node": "رد: تم", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
